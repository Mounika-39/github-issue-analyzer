# Copy this file to ".env" and fill it in. Never commit the real .env file.

# Optional but recommended. Raises GitHub's limit from 60 to 5,000 requests per hour.
# Create one at GitHub > Settings > Developer settings > Personal access tokens.
# A token with no permissions ticked is enough for public repositories.
GITHUB_TOKEN=

# How long a result is served from cache before GitHub is asked again (seconds).
CACHE_TTL_SECONDS=900

# Where the SQLite file lives when running without Docker.
DATABASE_PATH=data/issues.db
